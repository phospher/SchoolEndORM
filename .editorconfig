root = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:warning

csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion

dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_auto_properties = true:warning
dotnet_style_readonly_field = true:suggestion
# IDE0005 在 build 上运行要求 GenerateDocumentationFile=true（否则触发 EnableGenerateDocumentationFile 编译警告，
# 而开启文档生成会引入大量 CS1591）。降为 suggestion：IDE 仍会提示，且可用 `dotnet format style --diagnostics IDE0005` 清理。
dotnet_diagnostic.IDE0005.severity = suggestion

dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning

dotnet_naming_rule.private_field_underscore.severity = warning
dotnet_naming_rule.private_field_underscore.symbols = private_fields
dotnet_naming_rule.private_field_underscore.style = underscore_style

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_style.required_prefix = _
dotnet_naming_style.underscore_style.capitalization = camel_case

# const 字段走 PascalCase，不被 _camelCase 私有字段规则捕获
dotnet_naming_rule.const_fields_pascal_case.severity = warning
dotnet_naming_rule.const_fields_pascal_case.symbols = const_fields
dotnet_naming_rule.const_fields_pascal_case.style = pascal_case_style

dotnet_naming_symbols.const_fields.applicable_kinds = field
dotnet_naming_symbols.const_fields.required_modifiers = const

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# ---- 范围外规则抑制（§13 最终验证）----
# CA1716/CA1720：'object' 参数名与 'Event'/'Operator' 等命名属于公开 API 拼写，本次不改名（红线）。
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1720.severity = none
# CA1840：Thread.CurrentThread.ManagedThreadId 位于手写锁的 GlobalCache.cs 中，禁止改动 Thread 语句。
dotnet_diagnostic.CA1840.severity = none
# CA1859："用具体类型代替接口" 属于改变签名的微优化，超出本次范围。
dotnet_diagnostic.CA1859.severity = none

# ---- .NET 10 SDK 新增诊断的处置（2.16–2.18）----
# IDE0032：EntityMapping / PersistenceContext / LoadList / FakePersistenceContext 的后备字段，其属性访问器带有
# null-coalescing（?? [] / ?? new Dictionary）、懒加载（??= LoadItems()）与 null 时 throw 语义；改成自动属性会丢失这些判定，
# 与 C6 语义等价硬边界及「LoadList 懒加载只触发一次」红线冲突。行为等价的 C# 14 `field` 改写属于提交 #3 范围
# （C8：每个提交只承载一类变换），故本次基础设施提交不改行为，按范围外规则抑制。
dotnet_diagnostic.IDE0032.severity = none
# CA2263：建议的 Assert.IsInstanceOfType<T> 泛型改写属于提交 #2 的 3.5（MSTest 4 断言规范化），超出本次基础设施提交范围
# （C8：每个提交只承载一类变换）；它不改判定顺序与输出文本、与 ORM 红线无关，待 3.5 就地修复，故按范围外规则抑制。
dotnet_diagnostic.CA2263.severity = none
